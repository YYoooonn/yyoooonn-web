{
  "name": "@repo/graphql",
  "version": "0.1.0",
  "typesVersions": {
    "*": {
      "server": [
        "generated/server/resolvers-types.d.ts"
      ]
    }
  },
  "exports": {
    "./client": {
      "types": "./generated/client/index.ts",
      "default": "./generated/client/index.ts"
    },
    "./server": {
      "types": "./generated/server/resolvers-types.d.ts",
      "default": "./generated/server/resolvers-types.d.ts"
    }
  },
  "scripts": {
    "codegen": "pnpm codegen:client && pnpm codegen:server",
    "codegen:client": "graphql-codegen --config codegen.client.ts",
    "codegen:server": "graphql-codegen --config codegen.server.ts"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/client-preset": "^4.8.3",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-codegen/typescript-react-apollo": "^4.1.2",
    "@graphql-codegen/typescript-resolvers": "^4.5.1",
    "graphql": "^16.11.0",
    "graphql-tag": "^2.12.6",
    "prettier": "^3.6.2"
  },
  "peerDependencies": {
    "graphql": "^16.11.0",
    "@apollo/client": "^3.13.9"
  },
  "files": [
    "generated",
    "**/*.graphql"
  ]
}
