{
  "name": "mono",
  "private": true,
  "scripts": {
    "build": "pnpm env:sync && turbo run build",
    "build:web": "pnpm env:sync && turbo run build --filter=web...",
    "dev": "turbo run dev",
    "dev:all": "chmod +x scripts/dev-with-cleanup.sh && ./scripts/dev-with-cleanup.sh",
    "db:migrate:deploy": "turbo run db:migrate:deploy",
    "db:migrate:dev": "turbo run db:migrate:dev",
    "db:push": "turbo run db:push",
    "db:seed": "turbo run db:seed",
    "db:ready": "sleep 5 && pnpm db:migrate:dev",
    "db:up": "docker compose -f docker-compose.dev.yml --profile db up -d",
    "db:down": "docker compose -f docker-compose.dev.yml --profile db down",
    "env:sync": "chmod +x scripts/env-sync.sh && ./scripts/env-sync.sh",
    "docker:dev": "docker compose -f docker-compose.dev.yml --profile test up --build",
    "docker:prod": "docker compose -f docker-compose.prod.yml --profile prod up",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml --profile prod build",
    "docker:push": "chmod +x scripts/docker-push.sh && ./scripts/docker-push.sh",
    "generate": "turbo run generate",
    "codegen": "turbo run codegen",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "lint": "turbo run lint",
    "start": "turbo run start",
    "prepare": "if [ \"$NODE_ENV\" != \"production\" ]; then husky; fi"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "pnpm format"
    ]
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "turbo": "^2.9.3",
    "typescript": "6.0.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "@babel/runtime-corejs3@<7.26.10": ">=7.26.10",
      "brace-expansion@>=1.0.0 <=1.1.11": ">=1.1.12",
      "brace-expansion@>=2.0.0 <=2.0.1": ">=2.0.2",
      "@eslint/plugin-kit@<0.3.4": ">=0.3.4",
      "sha.js@<=2.4.11": ">=2.4.12",
      "tmp@<=0.2.3": ">=0.2.4",
      "form-data@>=4.0.0 <4.0.4": ">=4.0.4",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "jws@=4.0.0": ">=4.0.1",
      "jws@<3.2.3": ">=3.2.3",
      "lodash@>=4.0.0 <=4.17.22": ">=4.17.23",
      "diff@>=4.0.0 <4.0.4": ">=4.0.4",
      "js-yaml@>=4.0.0 <4.1.1": ">=4.1.1",
      "qs@>=6.7.0 <=6.14.1": ">=6.14.2",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@>=9.0.0 <9.0.6": ">=9.0.6",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "basic-ftp@<5.2.0": ">=5.2.0",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "minimatch@<3.1.4": ">=3.1.4",
      "ajv@<6.14.0": ">=6.14.0",
      "qs@<6.14.1": ">=6.14.1",
      "immutable@<3.8.3": ">=3.8.3",
      "flatted@<3.4.0": ">=3.4.0",
      "flatted@<=3.4.1": ">=3.4.2",
      "handlebars@>=4.0.0 <=4.7.8": ">=4.7.9",
      "brace-expansion@<1.1.13": ">=1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": ">=2.0.3",
      "handlebars@>=4.0.0 <4.7.9": ">=4.7.9",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "handlebars@>=4.6.0 <=4.7.8": ">=4.7.9",
      "lodash@<=4.17.23": ">=4.18.1"
    }
  }
}
