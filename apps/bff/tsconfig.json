{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "rootDirs": ["src"],
    "outDir": "dist",
    "lib": ["es2020"],
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@repo/shared/graphql": ["../../packages/shared/src/graphql/index.ts"],
      "@repo/shared/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "./dist/**/*"]
}
